# Wumpus World using Propositional Logic
# and Forward Chaining

SIZE = 4

# Hidden locations
PITS = {(4, 4)}
WUMPUS = (4, 1)
GOLD = (1, 4)

START = (1, 1)

# Generate all grid cells
all_cells = {
    (r, c)
    for r in range(1, SIZE + 1)
    for c in range(1, SIZE + 1)
}

# Knowledge Base
possible_pits = all_cells - {START}
possible_wumpus = all_cells - {START}

visited = set()
safe_cells = {START}


# Find neighboring cells
def get_neighbors(cell):

    r, c = cell

    directions = [
        (-1, 0),
        (1, 0),
        (0, -1),
        (0, 1)
    ]

    neighbors = []

    for dr, dc in directions:

        nr = r + dr
        nc = c + dc

        if 1 <= nr <= SIZE and 1 <= nc <= SIZE:
            neighbors.append((nr, nc))

    return neighbors


# Observe percepts
def perceive(cell):

    neighbors = get_neighbors(cell)

    breeze = any(n in PITS for n in neighbors)

    stench = any(n == WUMPUS for n in neighbors)

    glitter = (cell == GOLD)

    return breeze, stench, glitter


# Forward Chaining
def forward_chaining():

    while True:

        old_safe = set(safe_cells)

        for cell in visited:

            breeze, stench, glitter = perceive(cell)

            neighbors = get_neighbors(cell)

            # Rule 1: No Breeze
            if not breeze:
                possible_pits.difference_update(neighbors)

            # Rule 2: No Stench
            if not stench:
                possible_wumpus.difference_update(neighbors)

        # Rule 3: Mark Safe Cells
        for cell in all_cells:

            if (cell not in possible_pits
                    and cell not in possible_wumpus):

                safe_cells.add(cell)

        # Stop at fixed point
        if safe_cells == old_safe:
            break


# Wumpus World Agent
def wumpus_agent():

    current = START

    print("WUMPUS WORLD SIMULATOR")
    print("Agent starts at:", START)

    while True:

        visited.add(current)

        # Current cell is safe because agent survived
        possible_pits.discard(current)
        possible_wumpus.discard(current)

        breeze, stench, glitter = perceive(current)

        print("\nVisiting:", current)
        print("Breeze:", breeze)
        print("Stench:", stench)
        print("Glitter:", glitter)

        # Check for gold
        if glitter:
            print("\nGOLD FOUND!")
            print("Agent successfully completed the mission.")
            break

        # Apply Forward Chaining
        forward_chaining()

        # Find safe unvisited cells
        next_cells = sorted(safe_cells - visited)

        print("Safe unvisited cells:", next_cells)

        # No safe cell available
        if not next_cells:
            print("\nNo safe cells left to explore.")
            break

        # Move to next safe cell
        current = next_cells[0]

    print("\nVisited Cells:", sorted(visited))


# Main Program
wumpus_agent()


Q7-Lab Manual 7-Parsing First-Order Logic Sentences and Performing Unification, Forward Chaining and Backward Chaining.

Code-

import re
import itertools

# --------------------------------
# 1. Parse First-Order Logic
# --------------------------------

def parse_atom(text):
    match = re.match(r"(\w+)\((.*)\)", text.strip())

    if not match:
        raise ValueError("Invalid FOL expression: " + text)

    predicate = match.group(1)
    args = tuple(
        arg.strip() for arg in match.group(2).split(",")
    )

    return (predicate, args)


def parse_rule(text):
    left, right = text.split("=>")

    premises = [
        parse_atom(p.strip())
        for p in left.split("&")
    ]

    conclusion = parse_atom(right.strip())

    return (premises, conclusion)


# --------------------------------
# 2. Unification
# --------------------------------

def is_variable(term):
    return term[0].islower()


def substitute(term, theta):
    while is_variable(term) and term in theta:
        term = theta[term]

    return term


def unify_terms(x, y, theta):

    x = substitute(x, theta)
    y = substitute(y, theta)

    if x == y:
        return theta

    if is_variable(x):
        theta[x] = y
        return theta

    if is_variable(y):
        theta[y] = x
        return theta

    return None


def unify_atoms(atom1, atom2, theta=None):

    if theta is None:
        theta = {}

    if atom1[0] != atom2[0]:
        return None

    if len(atom1[1]) != len(atom2[1]):
        return None

    theta = theta.copy()

    for x, y in zip(atom1[1], atom2[1]):

        theta = unify_terms(x, y, theta)

        if theta is None:
            return None

    return theta


def apply_substitution(atom, theta):

    return (
        atom[0],
        tuple(substitute(arg, theta) for arg in atom[1])
    )


def has_variables(atom):
    return any(is_variable(x) for x in atom[1])


# --------------------------------
# 3. Knowledge Base
# --------------------------------

fact_text = [
    "American(West)",
    "Missile(M1)",
    "Owns(Nono,M1)",
    "Enemy(Nono,America)"
]

rule_text = [
    "Missile(x) => Weapon(x)",

    "Enemy(x,America) => Hostile(x)",

    "Missile(x) & Owns(Nono,x) => Sells(West,x,Nono)",

    "American(x) & Weapon(y) & Sells(x,y,z) & Hostile(z) => Criminal(x)"
]

facts = set(parse_atom(f) for f in fact_text)

rules = [parse_rule(r) for r in rule_text]


# --------------------------------
# 4. Forward Chaining
# --------------------------------

def match_premises(premises, theta, known_facts):

    if not premises:
        yield theta
        return

    first = apply_substitution(premises[0], theta)

    for fact in known_facts:

        new_theta = unify_atoms(first, fact, theta)

        if new_theta is not None:

            yield from match_premises(
                premises[1:],
                new_theta,
                known_facts
            )


def forward_chaining(query):

    changed = True

    while changed:

        changed = False

        for premises, conclusion in rules:

            for theta in match_premises(
                premises, {}, list(facts)
            ):

                new_fact = apply_substitution(
                    conclusion, theta
                )

                if not has_variables(new_fact):

                    if new_fact not in facts:

                        facts.add(new_fact)
                        print("Derived:", new_fact)
                        changed = True

        if query in facts:
            return True

    return query in facts


# --------------------------------
# 5. Backward Chaining
# --------------------------------

counter = itertools.count()


def standardize_rule(rule):

    premises, conclusion = rule

    variables = set()

    for atom in premises + [conclusion]:
        for arg in atom[1]:
            if is_variable(arg):
                variables.add(arg)

    rename = {
        v: "v" + str(next(counter)) + v
        for v in variables
    }

    def rename_atom(atom):
        return (
            atom[0],
            tuple(rename.get(x, x) for x in atom[1])
        )

    return (
        [rename_atom(a) for a in premises],
        rename_atom(conclusion)
    )


def prove_all(goals, theta, depth=0):

    if not goals:
        yield theta
        return

    if depth > 30:
        return

    first = goals[0]
    remaining = goals[1:]

    for new_theta in prove(first, theta, depth):

        yield from prove_all(
            remaining, new_theta, depth + 1
        )


def prove(goal, theta, depth=0):

    if depth > 30:
        return

    goal = apply_substitution(goal, theta)

    # Check known facts
    for fact in facts:

        new_theta = unify_atoms(goal, fact, theta)

        if new_theta is not None:
            yield new_theta

    # Check rules
    for rule in rules:

        premises, conclusion = standardize_rule(rule)

        new_theta = unify_atoms(
            goal, conclusion, theta
        )

        if new_theta is not None:

            yield from prove_all(
                premises, new_theta, depth + 1
            )


def backward_chaining(query):

    return next(prove(query, {}), None) is not None


# --------------------------------
# 6. Main Program
# --------------------------------

print("FIRST-ORDER LOGIC REASONING")

# Unification example
print("\nUnification Example:")

atom1 = parse_atom("Loves(x,Mary)")
atom2 = parse_atom("Loves(John,Mary)")

print("Atom 1:", atom1)
print("Atom 2:", atom2)
print("Substitution:", unify_atoms(atom1, atom2))


# Forward Chaining
query = parse_atom("Criminal(West)")

print("\nForward Chaining:")
result1 = forward_chaining(query)
print("Criminal(West):", result1)


# Backward Chaining
print("\nBackward Chaining:")
result2 = backward_chaining(query)
print("Criminal(West):", result2)

Q8-Lab Manual 8-Plan Actions Using Classical Planning (STRIPS-like Representation) for a Robot in a Grid World.

Code-

from collections import deque

# Grid size
SIZE = 4

# Start and Goal
START = (1, 1)
GOAL = (4, 4)

# Obstacles
obstacles = {
    (2, 2),
    (2, 3),
    (3, 2)
}

# STRIPS Action Representation
actions = {
    "MoveUp": (0, 1),
    "MoveDown": (0, -1),
    "MoveLeft": (-1, 0),
    "MoveRight": (1, 0)
}


# Apply STRIPS action
def apply_action(state, action):

    x, y = state

    dx, dy = actions[action]

    new_state = (x + dx, y + dy)

    # Preconditions
    if not (1 <= new_state[0] <= SIZE):
        return None

    if not (1 <= new_state[1] <= SIZE):
        return None

    if new_state in obstacles:
        return None

    # Delete-list: At(x, y)
    # Add-list: At(new_x, new_y)

    return new_state


# BFS Planner
def bfs_planner(start, goal):

    queue = deque([start])

    visited = {start}

    parent = {start: (None, None)}

    while queue:

        current = queue.popleft()

        # Goal checking
        if current == goal:

            plan = []
            path = []

            while current is not None:

                path.append(current)

                previous, action = parent[current]

                if action is not None:
                    plan.append(action)

                current = previous

            return plan[::-1], path[::-1]

        # Generate next states
        for action in actions:

            new_state = apply_action(
                current, action
            )

            if new_state is not None:
                if new_state not in visited:

                    visited.add(new_state)

                    parent[new_state] = (
                        current, action
                    )

                    queue.append(new_state)

    return None, None


# Main Program
print("CLASSICAL PLANNING USING STRIPS")

plan, path = bfs_planner(START, GOAL)

if plan is not None:

    print("\nStart Position:", START)
    print("Goal Position:", GOAL)

    print("\nAction Plan:")

    for step, action in enumerate(plan, 1):
        print(step, action)

    print("\nPath:", path)

    print("\nTotal Actions:", len(plan))

else:
    print("No valid plan found.")



Q9-Building a Bayesian Network for a Weather-Picnic Domain and Performing Inference Using Bayes' Rule.

Code-

from itertools import product

# Step 1: Define Bayesian Network

nodes = {
    "Rain": {
        "parents": [],
        "cpt": {(): 0.3}
    },

    "Wind": {
        "parents": [],
        "cpt": {(): 0.4}
    },

    "Picnic": {
        "parents": ["Rain", "Wind"],
        "cpt": {
            (False, False): 0.90,
            (False, True): 0.60,
            (True, False): 0.20,
            (True, True): 0.05
        }
    }
}

ORDER = ["Rain", "Wind", "Picnic"]


# Step 2: Calculate probability of True

def prob_true(var, assignment):

    parents = nodes[var]["parents"]

    key = tuple(assignment[p] for p in parents)

    return nodes[var]["cpt"][key]


# Step 3: Calculate Joint Probability

def joint_probability(assignment):

    p = 1.0

    for var in ORDER:

        p_true = prob_true(var, assignment)

        if assignment[var]:
            p *= p_true
        else:
            p *= (1 - p_true)

    return p


# Step 4: Generate all assignments

def all_assignments(variables):

    for values in product(
        [True, False], repeat=len(variables)
    ):

        yield dict(zip(variables, values))


# Step 5: Inference using Enumeration

def enumeration_ask(query_var, evidence):

    hidden_vars = [
        v for v in ORDER
        if v != query_var and v not in evidence
    ]

    scores = {}

    for query_value in [True, False]:

        total = 0.0

        for hidden_assignment in all_assignments(
            hidden_vars
        ):

            full_assignment = dict(hidden_assignment)

            full_assignment[query_var] = query_value

            full_assignment.update(evidence)

            total += joint_probability(full_assignment)

        scores[query_value] = total

    # Normalize using Bayes' Rule

    normalizer = sum(scores.values())

    return {
        k: v / normalizer
        for k, v in scores.items()
    }


# Step 6: Display Results

def show(dist, var_name):

    print(
        f"P({var_name} = True) = {dist[True]:.4f}"
    )

    print(
        f"P({var_name} = False) = {dist[False]:.4f}"
    )


# Step 7: Run Queries

print("Query 1: Overall chance of a picnic")

result1 = enumeration_ask("Picnic", {})

show(result1, "Picnic")


print("\nQuery 2: Chance of picnic when it is raining")

result2 = enumeration_ask(
    "Picnic", {"Rain": True}
)

show(result2, "Picnic")


print("\nQuery 3: Chance of rain when there is no picnic")

result3 = enumeration_ask(
    "Rain", {"Picnic": False}
)

show(result3, "Rain")


